# JARVEX — Plantilla de variables de entorno
# Copiar este archivo a .env.local y completar con valores reales.
# .env.local está en .gitignore — NUNCA commitear credenciales.

# ═══════════════════════════════════════════════════════════════════
# FRONTEND (Vite las inyecta al bundle de producción)
# ═══════════════════════════════════════════════════════════════════
# Estas también deben estar en Vercel → Settings → Environment Variables.

# ── Supabase ─────────────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────
VITE_APP_NAME=JARVEX
VITE_APP_VERSION=1.0.0

# ── Sentry (opcional, monitoring de errores) ─────────────────────────
# Ver EMERGENCY.md para cómo crear una cuenta. Plan free 5K eventos/mes.
# Crear: sentry.io → New Project → React → copiar el DSN
VITE_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
# BACKEND / SCRIPTS (NO se inyectan al bundle, solo se usan localmente)
# ═══════════════════════════════════════════════════════════════════

# ── Anthropic API ────────────────────────────────────────────────────
# Usada por /api/* serverless functions (Captura Mágica, sugerir cuenta PCGE, etc.)
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── OpenRouter — postprocesamiento del OCR (facturas y guías) ────────
# openrouter.ai → Keys. El paso "texto del OCR → JSON" sale de Claude Haiku y
# pasa a un modelo GRATUITO por OpenRouter; Claude queda de RESPALDO automático.
# Sin esta variable NO cambia nada: todo sigue corriendo en Claude.
# Certificados de calidad, SCTR y el fallback de visión NO se tocan (Sonnet).
OPENROUTER_API_KEY=
#
# Modelo titular. Default: 'inclusionai/ling-3.0-flash-fin:free' — el único
# gratuito medido que pasa el filtro de Zero Data Retention (servido por Novita).
OPENROUTER_STRUCT_MODEL=
# Respaldo(s) dentro de la misma llamada, separados por coma.
# Default: 'minimax/minimax-m3:free' (GMICloud, Mountain View).
OPENROUTER_STRUCT_FALLBACK=
#
# POLÍTICA DE DATOS exigida en CADA llamada. Acá viajan RUC, razón social,
# montos y a veces DNI: esto es lo que impide que caigan en un proveedor que
# entrene con ellos. Si ningún proveedor cumple, OpenRouter responde 404 y NO
# manda nada — falla cerrado, no se filtra.
#   zdr  (default) → Zero Data Retention: el proveedor ni siquiera lo guarda.
#   deny           → puede guardarlo para operar, pero NO entrenar con él.
# Ojo: bajar a 'deny' amplía la lista de modelos disponibles. Es una decisión
# de negocio, no un ajuste de rendimiento.
OPENROUTER_DATA_POLICY=
#
# Interruptor de reversión INSTANTÁNEO (no hace falta borrar la key):
#   openrouter (default) → postprocesamiento gratuito con respaldo en Claude
#   anthropic            → vuelve todo a Claude Haiku, como antes
IA_POSTPROCESO=

# ── Mistral — OCR de Captura Mágica ──────────────────────────────────
# console.mistral.ai → API Keys. Sin ella, captura-magica cae a Claude visión
# (funciona, pero es mucho más caro y más lento).
MISTRAL_API_KEY=
#
# ⚠️ EL ALIAS 'mistral-ocr-latest' SE MUEVE SOLO. El 16-jul-2026 pasó de OCR 3
# a OCR 4.1 y el precio se DUPLICÓ (USD 2 → 4 / 1000 páginas) sin que nadie lo
# eligiera. Si el costo importa, fijá un snapshot en vez de dejar decidir al alias.
#   mistral-ocr-2512  = OCR 3   — USD 2 / 1000 págs. Alcanza de sobra para las
#                                 facturas y guías digitales (PDF nítidos).
#   mistral-ocr-latest= OCR 4.1 — USD 4 / 1000 págs. Mejor en tablas, escaneos
#                                 y manuscrito.
MISTRAL_OCR_MODEL=
# OCR SOLO para certificados de calidad: son el documento difícil (tablas de
# laboratorio, escaneos) y el de menor volumen, así que ahí el OCR bueno se
# paga solo. Default 'mistral-ocr-latest'.
MISTRAL_OCR_MODEL_CERT=

# ── Supabase DB (origen de los backups con scripts/backup-supabase.sh) ──
# Sacar de: Supabase Dashboard → Settings → Database → Connection string
# Usar modo: Session pooler (puerto 5432, NO 6543 que es Transaction pooler)
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<tu-project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ── Supabase DB de prueba (target para scripts/verify-restore.sh) ──
# IMPORTANTE: crear un proyecto Supabase NUEVO (free tier) solo para validar
# restores. NUNCA usar las mismas credenciales que producción — el script
# rehúsa correr si detecta colisión, pero mejor no tentar al destino.
RESTORE_TARGET_HOST=aws-0-sa-east-1.pooler.supabase.com
RESTORE_TARGET_PORT=5432
RESTORE_TARGET_USER=postgres.<test-project-ref>
RESTORE_TARGET_PASSWORD=
RESTORE_TARGET_NAME=postgres

# ── Backups ──────────────────────────────────────────────────────────
BACKUP_DIR=$HOME/jarvex-backups
BACKUP_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════
# CLOUDFLARE R2 — fotos de evidencias (egress $0)
# ═══════════════════════════════════════════════════════════════════
# Credenciales S3 del bucket privado. Se crean en el dashboard de Cloudflare:
# R2 → Overview → API Tokens → Manage → Create Account API token →
# permiso "Object Read & Write" acotado al bucket. El Account ID está en esa
# misma pantalla. Van en Vercel (Production + Preview) para api/r2.js, y acá
# en .env.local para scripts/migrar-evidencias-r2.mjs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jarvex-evidencias
# Opcional, '1': saltea el HEAD de existencia en sign_get. Activar SOLO cuando
# Supabase Storage ya esté vacío (no queda fallback que valga la pena chequear).
R2_SKIP_HEAD=
#
# Flag de rollout del cliente (build-time, se hornea en el bundle de Vite):
#   off  (default) → todo sigue en Supabase Storage. Desplegar no cambia nada.
#   read           → LEE de R2, con fallback automático a Supabase.
#   on             → lee Y sube a R2.
VITE_R2_EVIDENCIAS=off
#
# CORS QUE NECESITA EL BUCKET (R2 no acepta comodines: orígenes exactos):
#   [{ "AllowedOrigins": ["https://jarvex-app.vercel.app",
#                         "https://jarvex-app-git-staging-znova15s-projects.vercel.app",
#                         "http://localhost:5173"],
#      "AllowedMethods": ["GET","PUT","HEAD"],
#      "AllowedHeaders": ["Content-Type","Cache-Control"],
#      "ExposeHeaders": ["ETag"], "MaxAgeSeconds": 3600 }]

# ═══════════════════════════════════════════════════════════════════
# E2E TESTING (tests/e2e/*.test.mjs)
# ═══════════════════════════════════════════════════════════════════
JX_TEST_EMAIL=
JX_TEST_PASSWORD=
JX_TEST_URL=https://jarvex-app.vercel.app/
