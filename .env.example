# JARVEX — Plantilla de variables de entorno
# Copiar este archivo a .env.local y completar con valores reales.
# .env.local está en .gitignore — NUNCA commitear credenciales.

# ═══════════════════════════════════════════════════════════════════
# FRONTEND (Vite las inyecta al bundle de producción)
# ═══════════════════════════════════════════════════════════════════
# Estas también deben estar en Vercel → Settings → Environment Variables.

# ── Supabase ─────────────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────
VITE_APP_NAME=JARVEX
VITE_APP_VERSION=1.0.0

# ── Sentry (opcional, monitoring de errores) ─────────────────────────
# Ver EMERGENCY.md para cómo crear una cuenta. Plan free 5K eventos/mes.
# Crear: sentry.io → New Project → React → copiar el DSN
VITE_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
# BACKEND / SCRIPTS (NO se inyectan al bundle, solo se usan localmente)
# ═══════════════════════════════════════════════════════════════════

# ── Anthropic API ────────────────────────────────────────────────────
# Usada por /api/* serverless functions (Captura Mágica, sugerir cuenta PCGE, etc.)
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Supabase DB (origen de los backups con scripts/backup-supabase.sh) ──
# Sacar de: Supabase Dashboard → Settings → Database → Connection string
# Usar modo: Session pooler (puerto 5432, NO 6543 que es Transaction pooler)
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<tu-project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ── Supabase DB de prueba (target para scripts/verify-restore.sh) ──
# IMPORTANTE: crear un proyecto Supabase NUEVO (free tier) solo para validar
# restores. NUNCA usar las mismas credenciales que producción — el script
# rehúsa correr si detecta colisión, pero mejor no tentar al destino.
RESTORE_TARGET_HOST=aws-0-sa-east-1.pooler.supabase.com
RESTORE_TARGET_PORT=5432
RESTORE_TARGET_USER=postgres.<test-project-ref>
RESTORE_TARGET_PASSWORD=
RESTORE_TARGET_NAME=postgres

# ── Backups ──────────────────────────────────────────────────────────
BACKUP_DIR=$HOME/jarvex-backups
BACKUP_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════
# E2E TESTING (tests/e2e/*.test.mjs)
# ═══════════════════════════════════════════════════════════════════
JX_TEST_EMAIL=
JX_TEST_PASSWORD=
JX_TEST_URL=https://jarvex-app.vercel.app/
